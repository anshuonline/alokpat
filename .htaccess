<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Skip existing files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route /article/<slug> to article.php?slug=<slug>
    RewriteRule ^article/([^/]+)/?$ article.php?slug=$1 [L,QSA]

    # Route /admin/<custom-slug> to admin/login.php?login_slug=<custom-slug>
    RewriteRule ^admin/([a-zA-Z0-9_-]+)/?$ admin/login.php?login_slug=$1 [L,QSA]
</IfModule>

# Prevent directory listing
Options -Indexes

# Block access to sensitive directories
RewriteRule ^config/ - [F,L]

# Set default charset
AddDefaultCharset UTF-8

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

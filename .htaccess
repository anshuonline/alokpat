<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force non-www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Skip existing files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route /category-slug/article-slug.html to article.php?slug=article-slug
    RewriteRule ^([^/]+)/([^/]+)\.html$ article.php?slug=$2 [L,QSA]
    # Sitemap rules
    RewriteRule ^sitemap\.xml$ sitemap.php?type=index [L,QSA]
    RewriteRule ^sitemap-posts\.xml$ sitemap.php?type=posts [L,QSA]
    RewriteRule ^sitemap-categories\.xml$ sitemap.php?type=categories [L,QSA]
    RewriteRule ^sitemap-authors\.xml$ sitemap.php?type=authors [L,QSA]

    # Route short links (e.g. /u47nncby)
    RewriteRule ^u([a-zA-Z0-9]+)$ redirect.php?code=$1 [L,QSA]

    # Route /admin/<custom-slug> to admin/login.php?login_slug=<custom-slug>
    RewriteRule ^admin/([a-zA-Z0-9_-]+)/?$ admin/login.php?login_slug=$1 [L,QSA]
</IfModule>

# Prevent directory listing
Options -Indexes

# Block access to sensitive directories
RewriteRule ^config/ - [F,L]

# Set default charset
AddDefaultCharset UTF-8

# ============================================================
# Enable GZIP compression
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
    # Remove browser bugs
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# ============================================================
# Browser Caching (Expires Headers)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Images — cache 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/gif  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Fonts — cache 1 year
    ExpiresByType font/woff  "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff  "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # CSS & JS — cache 1 week
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"

    # HTML — cache 1 hour (server handles page cache)
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ============================================================
# Cache-Control Headers
# ============================================================
<IfModule mod_headers.c>
    # Images
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Fonts
    <FilesMatch "\.(woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # CSS & JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom 404 Page
ErrorDocument 404 /404.php


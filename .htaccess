<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Skip existing files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route /category-slug/article-slug.html to article.php?slug=article-slug
    RewriteRule ^([^/]+)/([^/]+)\.html$ article.php?slug=$2 [L,QSA]
    # Sitemap rules
    RewriteRule ^sitemap\.xml$ sitemap.php?type=index [L,QSA]
    RewriteRule ^sitemap-posts\.xml$ sitemap.php?type=posts [L,QSA]
    RewriteRule ^sitemap-categories\.xml$ sitemap.php?type=categories [L,QSA]
    RewriteRule ^sitemap-authors\.xml$ sitemap.php?type=authors [L,QSA]

    # Route /admin/<custom-slug> to admin/login.php?login_slug=<custom-slug>
    RewriteRule ^admin/([a-zA-Z0-9_-]+)/?$ admin/login.php?login_slug=$1 [L,QSA]
</IfModule>

# Prevent directory listing
Options -Indexes

# Block access to sensitive directories
RewriteRule ^config/ - [F,L]

# Set default charset
AddDefaultCharset UTF-8

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

# Custom 404 Page
ErrorDocument 404 /404.php
